# ==============================================================================
# Django Backend Environment Configuration
# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file or real API keys to version control!
# ==============================================================================

# Django Secret Key (generate a strong random secret key for production)
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-secret-key-in-production

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated list of hostnames / IP addresses)
ALLOWED_HOSTS=localhost,127.0.0.1,your-ec2-ip-or-domain

# CORS Allowed Origins (comma-separated list of frontend URLs, e.g. Vercel deployment)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Set to True to allow all CORS origins (useful for testing, set to False in production)
CORS_ALLOW_ALL_ORIGINS=False

# CSRF Trusted Origins (comma-separated list of domains that are allowed to POST)
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Google Gemini API Key (Runtime environment variable, never bake into image)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional fallback AI)
GROQ_API_KEY=your_groq_api_key_here

# SQLite Database Directory (Inside Docker container, points to persistent volume)
DATABASE_DIR=/app/data
